---
import Layout from '../layouts/Layout.astro';

const stats = [{'val': '100Mbps', 'lbl': 'Dedicated Fiber Wi-Fi'}, {'val': '50+', 'lbl': 'Stop Kontak Listrik'}, {'val': '100%', 'lbl': 'Biji Kopi Nusantara'}, {'val': '24 Jam', 'lbl': 'Buka Setiap Hari'}];
const items = [{'name': 'Kopitiam Butter Coffee (Kopi Butter)', 'desc': 'Espresso pekat disiram susu kental manis dan potongan unsalted butter gurih.', 'price': 'Rp 22.000', 'tag': 'Signature'}, {'name': 'Traditional Kaya Butter Toast', 'desc': 'Roti panggang arang renyah diisi selai srikaya homemade dan mentega dingin.', 'price': 'Rp 18.000', 'tag': 'Must Try'}, {'name': 'Kopi O Kau (Black Coffee)', 'desc': 'Kopi hitam pekat racikan robusta Lampung dengan aroma karamel alami.', 'price': 'Rp 15.000', 'tag': 'Classic'}, {'name': 'Matcha Oat Latte', 'desc': 'Pure Uji Matcha Jepang dipadu dengan susu gandum (Oat milk) yang creamy.', 'price': 'Rp 28.000', 'tag': 'Non-Coffee'}];
const features = [{'icon': '📶', 'title': 'Wi-Fi Fiber Kencang', 'desc': 'Koneksi stabil tanpa buffering untuk Zoom call dan push code.'}, {'icon': '🔌', 'title': 'Stop Kontak di Setiap Meja', 'desc': 'Tidak perlu rebutan colokan listrik untuk laptop dan smartphone Anda.'}, {'icon': '🛋️', 'title': 'Kursi Ergonomis Spesia', 'desc': 'Didesain nyaman untuk duduk bekerja selama berjam-jam tanpa pegal.'}];
---

<Layout title="Kopitiam — Artisan Coffee & Work Lounge">
  <section class="hero">
    <div class="container">
      <div class="hero-badge">
        ☕ Freshly Roasted Single Origin Beans
      </div>
      <h1 class="hero-title">BUKAN SEKADAR KOPI, INI RUMAH KEDUA KAMU</h1>
      <p class="hero-desc">Rasakan racikan espresso otentik, roti kaya toast hangat, serta suasana tenang ber-AC dengan Wi-Fi super kencang untuk bekerja atau nongkrong.</p>
      
      <div style="display: flex; gap: 1rem; justify-content: center; align-items: center;">
        <a href="https://wa.me/6281234567890" class="btn-cta">
          Pesan Sekarang via WhatsApp
        </a>
        <a href="#katalog" style="padding: 0.75rem 1.5rem; border-radius: 99px; border: 1px solid var(--card-border); color: var(--text-main); font-weight: 600;">
          Lihat Katalog
        </a>
      </div>

      <div class="stats-grid">
        {stats.map((stat) => (
          <div class="stat-card">
            <div class="stat-val">{stat.val}</div>
            <div class="stat-lbl">{stat.lbl}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="katalog" class="catalog-section">
    <div class="container">
      <h2 class="section-title">PILAHAN PRODUK & LAYANAN UNGGULAN</h2>
      <div class="item-grid">
        {items.map((item) => (
          <div class="item-card">
            <div>
              <span class="item-tag">{item.tag}</span>
              <h3 class="item-name">{item.name}</h3>
              <p class="item-desc">{item.desc}</p>
            </div>
            <div class="item-footer">
              <span class="item-price">{item.price}</span>
              <a href="https://wa.me/6281234567890" style="color: var(--accent); font-weight: 700; font-size: 0.9rem;">Pesan &rarr;</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="keunggulan" class="features-section">
    <div class="container">
      <h2 class="section-title">FASILITAS WORK & LOUNGE</h2>
      <div class="features-grid">
        {features.map((feat) => (
          <div class="feature-card">
            <div class="feature-icon">{feat.icon}</div>
            <h3 class="feature-title">{feat.title}</h3>
            <p class="feature-desc">{feat.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
