---
import Layout from '../layouts/Layout.astro';

const items = [{"name": "Kopitiam Signature Latte", "price": "Rp 24.000", "desc": "Espresso racikan khas dipadu susu segar creamy dan sedikit touch caramel manis.", "img": "https://images.unsplash.com/photo-1534778101976-62847782c213?w=500&q=80", "badge": "SIGNATURE"}, {"name": "Creamy Velvet Chocolate", "price": "Rp 26.000", "desc": "Minuman cokelat kaya rasa tanpa kopi, sangat pas untuk bersantai sore hari.", "img": "https://images.unsplash.com/photo-1542990253-0d0f5be5f0ed?w=500&q=80", "badge": "NON-COFFEE"}, {"name": "Kopitiam Golden Fries", "price": "Rp 18.000", "desc": "Kentang goreng crispy dengan taburan bumbu gurih menemani momen diskusi.", "img": "https://images.unsplash.com/photo-1573080496219-bb080dd4f877?w=500&q=80", "badge": "SNACK"}, {"name": "Kaya Butter Toast", "price": "Rp 20.000", "desc": "Roti panggang renyah dengan olesan selai srikaya otentik dan lelehan mentega gurih.", "img": "https://images.unsplash.com/photo-1525351484163-7529414344d8?w=500&q=80", "badge": "FAVORITE"}];
const features = [{"icon": "\ud83c\udf31", "title": "Freshly Roasted Beans", "desc": "Biji kopi lokal pilihan disangrai secara berkala untuk menjaga aroma & cita rasa optimal."}, {"icon": "\ud83d\udcbb", "title": "Cozy Workstation", "desc": "Meja luas, stopkontak melimpah di setiap sudut, dan koneksi internet super kencang."}, {"icon": "\ud83c\udf70", "title": "Snack & Pastry Lezat", "desc": "Pendamping sempurna kopi hangat mulai dari kentang renyah hingga roti bakar mentega."}];
const stats = [{"num": "4.9 \u2605", "label": "Kepuasan Pengunjung"}, {"num": "100%", "label": "Biji Arabika Pilihan"}, {"num": "100 Mbps", "label": "High Speed Wi-Fi"}];
---

<Layout title="Kopitiam — Cafe Nyaman untuk Kerja & Nongkrong">
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="hero-overlay"></div>
    <div class="container hero-content">
      <div class="hero-badge">
        <span>☕ Specialty Artisan Coffee & Cozy Space</span>
      </div>
      <h1 class="hero-title">
        Your Table for Coffee, Work & Good Company.<br />
        <span class="text-gradient-accent">Kualitas Impeccable Terbaik.</span>
      </h1>
      <p class="hero-desc">
        Tempat nyaman untuk menyelesaikan pekerjaan, ngobrol hangat bersama teman, atau sekadar menikmati secangkir kopi segar dengan suasana tenang.
      </p>

      <div class="hero-buttons">
        <a href="#katalog" class="btn">
          <span>Jelajahi Katalog</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
        <a href="https://wa.me/?text=Halo%20KOPITIAM,%20saya%20mau%20konsultasi%20order" class="btn btn-secondary" target="_blank" rel="noopener noreferrer">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <span>Pesan via WhatsApp</span>
        </a>
      </div>

      <div class="hero-stats">
        {stats.map((s) => (
          <div class="stat-item">
            <h3>{s.num}</h3>
            <p>{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Keunggulan Section -->
  <section id="keunggulan" class="section container">
    <div class="section-header">
      <p class="section-subtitle">MENGAPA MEMILIH KAMI</p>
      <h2 class="section-title">Keunggulan Utama KOPITIAM</h2>
    </div>
    <div class="features-grid">
      {features.map((f) => (
        <div class="feature-card">
          <div class="feature-icon">{f.icon}</div>
          <h3 class="feature-title">{f.title}</h3>
          <p class="feature-desc">{f.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Katalog Section -->
  <section id="katalog" class="section container">
    <div class="section-header">
      <p class="section-subtitle">PILIHAN TERBAIK</p>
      <h2 class="section-title">Katalog Produk & Layanan Unggulan</h2>
    </div>
    <div class="cards-grid">
      {items.map((item) => (
        <div class="card">
          <div class="card-img-wrap">
            <img src={item.img} alt={item.name} class="card-img" />
            <span class="badge">{item.badge}</span>
          </div>
          <div class="card-body">
            <h3 class="card-title">{item.name}</h3>
            <p class="card-desc">{item.desc}</p>
            <div class="card-footer">
              <span class="card-price">{item.price}</span>
              <a href={`https://wa.me/?text=Halo%20KOPITIAM,%20saya%20tertarik%20order%20${encodeURIComponent(item.name)}`} class="btn btn-card" target="_blank" rel="noopener noreferrer">
                <span>Pesan</span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA Box Section -->
  <section id="lokasi" class="container">
    <div class="cta-box">
      <div class="cta-content">
        <h2 class="cta-title">Siap Menikmati Layanan Terbaik dari KOPITIAM?</h2>
        <p class="cta-desc">Hubungi tim kami via WhatsApp resmi untuk konsultasi gratis, tanya jawab produk, atau pemesanan cepat hari ini.</p>
        <a href="https://wa.me/?text=Halo%20KOPITIAM" class="btn" style="padding: 1rem 2.5rem; font-size: 1.1rem;" target="_blank" rel="noopener noreferrer">
          <span>Hubungi Kami Sekarang</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
